Mail_To=info@investera.com,anisha.a@nexuses.in
FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# MongoDB (stores blog posts managed in Payload at /admin, contact submissions
# and newsletter subscribers). Required for the blog.
MONGODB_URI=
MONGODB_DB=investera

# Secret used to sign Payload admin login JWTs. Use a long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs out all admin users.
AUTH_SECRET=
# Legacy fallback, used only when AUTH_SECRET is not set.
PAYLOAD_SECRET=

# Public URL of this site, without a trailing slash (e.g. http://localhost:3001
# locally, https://www.investera.com in production). Used by the Payload admin.
NEXT_PUBLIC_SERVER_URL=
